# Copy this file to .env in the project root and fill in the values you need.
# Every value below has a safe default baked into the code, so the app runs
# out of the box even with an empty .env - the exceptions are called out below.

# --- Security ---
# Change this in any real deployment. Used to sign JWT session tokens.
SECRET_KEY=change-this-secret-key-in-production

# --- Database ---
# Default is a local SQLite file - nothing to configure for local dev.
DATABASE_URL=sqlite:///./fraud_detection.db

# --- ML engine ---
# Where the backend calls to get a fraud/anomaly score. Only change this if
# you run the ML engine on a different host/port.
ML_API_URL=http://127.0.0.1:8001/predict

# --- Admin access ---
# Comma-separated extra emails that should get the "admin" role on login,
# in addition to the built-in demo admin (manishsahani.edu@gmail.com).
ADMIN_EMAILS=

# --- OTP email delivery (SMTP) ---
# Leave SMTP_HOST empty to skip real email entirely: the OTP will be
# returned directly in the API response / shown in the UI instead, which is
# enough to test the OTP flow with zero setup.
#
# To send a real email via Gmail:
#   1. Turn on 2-Step Verification on the Gmail account (Google Account -> Security).
#   2. Go to Security -> App Passwords -> create one for "Mail".
#   3. Use the Gmail address as SMTP_USERNAME/SMTP_FROM_EMAIL and the
#      16-character app password (no spaces) as SMTP_PASSWORD below.
#   Your normal Gmail login password will NOT work here - it must be an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# If true, OTP is returned in the API response when SMTP isn't configured.
ALLOW_OTP_RESPONSE_FALLBACK=true

# --- Google Sign-In (optional) ---
# Only needed if you want the "Sign in with Google" button to work.
GOOGLE_CLIENT_ID=
